TELEGRAM_BOT_TOKEN=your_telegram_bot_token

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=your_database_name
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_database_password

# Use a cloud-reachable provider on Netlify (ollama will not work there).
AI_PROVIDER=qwen

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

QWEN_API_KEY=
QWEN_BASE_URL=https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max

DATABASE_URL=postgresql://...
# Set true for hosted Postgres (Neon/Supabase/etc). Auto-enabled on Netlify.
DATABASE_SSL=false

NODE_ENV=development

# Netlify webhook setup
WEBHOOK_SECRET=some_long_random_secret
WEBHOOK_SETUP_KEY=another_long_random_secret
